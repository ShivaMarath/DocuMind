# --- Provider: "openai" or "gemini" ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=

# Optional model overrides (defaults shown)
# CHAT_MODEL=gpt-4o-mini            # gemini default: gemini-2.5-flash
# EMBEDDING_MODEL=text-embedding-3-small   # gemini default: models/gemini-embedding-001

# --- Qdrant ---
# Leave QDRANT_URL empty to use embedded local storage in ./.qdrant (no Docker needed)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=documind

# --- RAG tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MAX_RETRIEVAL_ATTEMPTS=2
MAX_GENERATION_ATTEMPTS=2
